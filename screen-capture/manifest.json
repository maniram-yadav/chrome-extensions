{
  "manifest_version": 3,
  "name": "Screen Capture",
  "version": "1.0.0",
  "description": "Click the floating button, drag over any area of the page, and it is captured instantly. Review all captures in the popup and download one or all.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "clipboardWrite", "downloads", "scripting", "storage", "unlimitedStorage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Screen Capture",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "start-capture": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Start selecting an area to capture"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
