{
  "manifest_version": 3,
  "name": "Area Video Recorder",
  "version": "1.0.0",
  "description": "Record a selected area of the current page with tab audio + microphone, add a text label overlay, and download recordings.",
  "permissions": [
    "tabCapture",
    "offscreen",
    "scripting",
    "activeTab",
    "storage",
    "downloads",
    "unlimitedStorage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Area Video Recorder",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
