{
  "manifest_version": 3,
  "name": "Chat Media - AI Content Generator",
  "version": "1.0.0",
  "description": "Generate text, images and video with OpenAI, Google Gemini and xAI Grok. Save system prompts and API keys, then copy or download the results.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "sidePanel", "clipboardWrite"],
  "host_permissions": [
    "https://api.openai.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.x.ai/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Chat Media",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
